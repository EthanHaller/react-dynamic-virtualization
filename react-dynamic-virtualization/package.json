{
  "name": "react-dynamic-virtualization",
  "version": "1.0.0",
  "description": "React list virtualization for items whose size can change over time.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:typecheck": "tsc --noEmit -p tsconfig.test.json",
    "build": "tsc --noEmit && vite build"
  },
  "keywords": [
    "React",
    "ReactJs",
    "Virtual",
    "Virtualization",
    "List",
    "Dynamic",
    "Size",
    "Change",
    "Over",
    "Time",
    "Infinite",
    "Scroll",
    "Load More"
  ],
  "author": "Ethan Haller",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EthanHaller/react-dynamic-virtualization.git"
  },
  "type": "module",
  "license": "MIT",
  "dependencies": {
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
